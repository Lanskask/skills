{
  "$comment": "Pass-3 output: work/drafts/L-xx.json. Block fields depend on block.type (x-by-type).",
  "type": "object",
  "required": ["id", "title", "metaphor", "hook", "why_care", "screens", "quiz", "glossary", "key_takeaways", "sources"],
  "properties": {
    "id": {"type": "string", "pattern": "^L-[0-9]{2,3}$"},
    "title": {"type": "string", "minLength": 3},
    "metaphor": {"type": "string", "minLength": 10, "maxLength": 300},
    "hook": {"type": "string", "minLength": 10, "maxLength": 300},
    "why_care": {"type": "string", "minLength": 10, "maxLength": 300},
    "screens": {
      "type": "array", "minItems": 2, "maxItems": 6,
      "items": {
        "type": "object", "required": ["id", "heading", "covers", "blocks"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "heading": {"type": "string", "minLength": 3, "maxLength": 100},
          "covers": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
          "blocks": {
            "type": "array", "minItems": 1, "maxItems": 8,
            "items": {
              "type": "object", "required": ["type"],
              "x-by-type": {
                "field": "type",
                "schemas": {
                  "text": {"required": ["text", "cite"], "props": {"text": "string", "cite": "pages"}},
                  "cards": {"required": ["items", "cite"], "props": {"items": "titled-items", "cite": "pages"}},
                  "steps": {"required": ["items", "cite"], "props": {"items": "titled-items", "cite": "pages"}},
                  "quote": {"required": ["text", "page", "meaning"], "props": {"text": "string", "page": "page", "meaning": "string", "shown": "string"}},
                  "code": {"required": ["code", "lang", "page", "lines"], "props": {"code": "string", "lang": "string", "page": "page", "lines": "codelines", "note": "string"}},
                  "figure": {"required": ["fig", "page", "caption"], "props": {"fig": "string", "page": "page", "caption": "string", "alt": "string"}},
                  "diagram": {"required": ["kind", "title", "caption", "cite"], "props": {"kind": "string", "title": "string", "caption": "string", "cite": "pages"}},
                  "task": {"required": ["statement", "page", "plain"], "props": {"statement": "string", "shown": "string", "page": "page", "plain": "string", "hint": "string"}},
                  "math": {"required": ["latex", "origin", "symbols", "cite"], "props": {"latex": "string", "origin": "origin", "symbols": "symbols", "cite": "pages", "caption": "string", "eq": "string", "checked_against": "checked"}},
                  "callout": {"required": ["variant", "title", "text", "cite"], "props": {"variant": "variant", "title": "string", "text": "string", "cite": "pages"}}
                }
              }
            }
          }
        }
      }
    },
    "quiz": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["question", "options", "answer", "explain_right", "explain_wrong", "cite"],
        "properties": {
          "question": {"type": "string", "minLength": 10},
          "options": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "string", "minLength": 1}},
          "answer": {"type": "integer", "minimum": 0},
          "explain_right": {"type": "string", "minLength": 10},
          "explain_wrong": {"type": "string", "minLength": 10},
          "cite": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}
        }
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object", "required": ["term", "definition", "cite"],
        "properties": {
          "term": {"type": "string", "minLength": 2, "maxLength": 60},
          "definition": {"type": "string", "minLength": 10, "maxLength": 400},
          "cite": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}
        }
      }
    },
    "key_takeaways": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"type": "string", "minLength": 10}},
    "sources": {
      "type": "object", "required": ["chapters", "read_full"],
      "properties": {
        "chapters": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "read_full": {
          "type": "array",
          "items": {"type": "object", "required": ["chapter", "pages", "reason"],
                    "properties": {"chapter": {"type": "string"}, "pages": {"type": "string"}, "reason": {"type": "string", "minLength": 5}}}
        }
      }
    }
  }
}
