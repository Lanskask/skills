{
  "$comment": "Pass-1 output: work/outline.json. Validated by scripts/b2c_lib/validate.py (JSON-Schema subset + x-by-type).",
  "type": "object",
  "required": ["book", "modules"],
  "properties": {
    "book": {
      "type": "object",
      "required": ["title", "lang"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "lang": {"type": "string", "enum": ["en", "ru"]},
        "course_title": {"type": "string"},
        "audience": {"type": "string"}
      }
    },
    "accent": {"type": "string", "enum": ["indigo", "vermillion", "coral", "teal", "amber", "forest"]},
    "modules": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "title", "subtitle", "lessons"],
        "properties": {
          "id": {"type": "string", "pattern": "^M[0-9]{1,2}$"},
          "title": {"type": "string", "minLength": 3, "maxLength": 80},
          "subtitle": {"type": "string", "minLength": 5, "maxLength": 200},
          "lessons": {
            "type": "array", "minItems": 1, "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["id", "title", "objectives", "source_refs"],
              "properties": {
                "id": {"type": "string", "pattern": "^L-[0-9]{2,3}$"},
                "title": {"type": "string", "minLength": 3, "maxLength": 100},
                "objectives": {"type": "array", "minItems": 2, "maxItems": 5,
                               "items": {"type": "string", "minLength": 8, "maxLength": 200}},
                "source_refs": {
                  "type": "array", "minItems": 1,
                  "items": {
                    "type": "object", "required": ["chapter"],
                    "properties": {
                      "chapter": {"type": "string", "pattern": "^ch[0-9]{2,3}$"},
                      "pages": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
                      "keywords": {"type": "array", "items": {"type": "string"}}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {"type": "object", "required": ["chapter", "reason"],
                "properties": {"chapter": {"type": "string"}, "reason": {"type": "string", "minLength": 5}}}
    }
  }
}
